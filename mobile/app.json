{
  "expo": {
    "name": "DaSync",
    "slug": "dasync",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.example.dasync",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "DaSync подключается к вашему ноутбуку в домашней сети.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0b1020",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.example.dasync",
      "permissions": [
        "CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Камера нужна только чтобы отсканировать QR-код на ноутбуке и подключить его."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0b1020",
          "imageWidth": 200
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "DaSync берёт фото и видео из галереи, чтобы отправить их на ноутбук."
        }
      ]
    ],
    "scheme": "dasync",
    "backgroundColor": "#0b1020"
  }
}